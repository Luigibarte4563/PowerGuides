# Base URL of the PowerGuide Dagupan PHP API (XAMPP).
#
# Option A - absolute URL (works when the API sends CORS headers for the dev
# origin; note the API currently only allows `http://localhost:5173`):
VITE_API_BASE_URL=http://localhost/CrowdsourcedAPI

# Option B - relative path, recommended for local development. Requests go to
# the Vite dev server and are forwarded to Apache by the proxy configured in
# vite.config.js, so there is no CORS involved and the session cookie always
# works. Comment out the line above and uncomment this one:
# VITE_API_BASE_URL=/CrowdsourcedAPI
