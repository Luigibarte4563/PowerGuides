# Base URL used by every API request (see src/api/client.js).
#
# Option A - RECOMMENDED, and the default. Relative path: requests go to the Vite
# dev server, which forwards /CrowdsourcedAPI to Apache using the proxy in
# vite.config.js. The browser therefore only ever talks to a single origin, so
# CORS never applies and the jwt_token session cookie always works - whichever
# host or port you open the dev server on (localhost, 127.0.0.1, or a LAN IP).
VITE_API_BASE_URL=/CrowdsourcedAPI

# Where that proxy forwards to. Only change this if Apache is not reachable on
# this machine's localhost:80, e.g. when the API runs on another box:
#   API_PROXY_TARGET=http://192.168.1.10:8080
# API_PROXY_TARGET=http://localhost

# Option B - absolute URL, bypassing the proxy. Requests then go cross-origin
# (different port), so the API has to allow this app's origin in ITS config: set
# ALLOWED_ORIGINS in CrowdsourcedAPI/.env, which feeds config/cors.php. The
# built-in default allows http://localhost:5173 and http://localhost:5174 only,
# so a LAN origin such as http://192.168.1.20:5174 is rejected until you add it.
# Use this only for a same-origin deployment where the app is served by Apache.
# VITE_API_BASE_URL=http://localhost/CrowdsourcedAPI
